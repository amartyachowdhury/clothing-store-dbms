# Copy to .env at the repo root for docker compose (optional; defaults work for local dev).
# Never use these defaults on a publicly reachable host.

# PostgreSQL (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothing_store
POSTGRES_PORT=5433

# Host ports
BACKEND_PORT=4000
WEB_PORT=3000

# API security (optional — leave API_KEY empty to disable auth locally)
API_KEY=
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
