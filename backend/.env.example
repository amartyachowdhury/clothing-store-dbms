# Local backend (npm run dev). Copy to .env — do not commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/clothing_store?schema=public"
PORT=4000

# Optional API protection (unset = open API for local dev)
API_KEY=

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# Rate limit: max requests per client per window
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Logging: pretty (dev) or json (production / log aggregators)
LOG_FORMAT=pretty
